	(text "E-stop: fails safe without firmware. Contact 1 is in series with the relay coil, so"
		(exclude_from_sim no)
		(at 25.4 20.32 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "0a9024cd-b7a4-5fb4-b99b-8c66a0bc0548")
	)
	(text "pressing it drops the relay whatever the MCU does. Contact 2 is read back; a difference"
		(exclude_from_sim no)
		(at 25.4 25.4 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "b2bb464f-da32-5659-aed6-c724e2303cc0")
	)
	(text "between the two is a wiring fault. A broken wire looks the same as pressing the button."
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "cde1a733-d666-50fe-b601-54769e27adf5")
	)
	(text "Relay contacts drive an external contactor coil or a supply's remote enable. Not rated for 48 V motor current."
		(exclude_from_sim no)
		(at 25.4 35.56 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "cf4ad17e-26cf-56e2-9121-a92e82b9d593")
	)
